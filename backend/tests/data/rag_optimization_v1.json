{
  "name": "security_retrieval_smoke_v1",
  "description": "Small handwritten smoke set assembled from existing fixtures. Topic-disjoint splits; not an independent external benchmark. Test labels are for final audit only, never candidate selection.",
  "documents": [
    {
      "id": "sql_parameterization",
      "text": "防止 SQL 注入应把用户输入作为参数绑定到预编译语句，避免拼接 SQL 字符串；数据库账号还应遵循最小权限。"
    },
    {
      "id": "sql_detection",
      "text": "SQL 注入检测可通过错误回显、布尔条件和时间延迟等方式发现可疑入口，但扫描必须获得授权并限制频率。"
    },
    {
      "id": "xss_output",
      "text": "防止反射型 XSS 要按 HTML、属性、URL 或脚本上下文进行输出编码，避免把不可信内容直接写入页面。"
    },
    {
      "id": "xss_csp",
      "text": "内容安全策略 CSP 可限制脚本来源，降低部分 XSS 利用风险，但不能代替输出编码和安全的 DOM 操作。"
    },
    {
      "id": "csrf_token",
      "text": "CSRF 防护通常使用不可预测的请求令牌，并结合 SameSite Cookie、来源校验和敏感操作二次确认。"
    },
    {
      "id": "cors_policy",
      "text": "CORS 控制浏览器是否允许跨源脚本读取响应；服务端应精确配置允许的 Origin，不能把它当作身份认证。"
    },
    {
      "id": "ssrf_egress",
      "text": "SSRF 防护应限制服务端出站目标，解析并校验最终 IP，阻止访问内网、云元数据地址和不允许的协议。"
    },
    {
      "id": "redirect_validation",
      "text": "开放重定向防护应使用可信目标白名单或相对路径，并避免直接信任用户提交的跳转 URL。"
    },
    {
      "id": "jwt_validation",
      "text": "验证 JWT 时应固定允许的签名算法，检查签名、过期时间、发行者和受众，并妥善轮换签名密钥。"
    },
    {
      "id": "session_cookie",
      "text": "会话 Cookie 应设置 HttpOnly、Secure、SameSite 和适当的有效期；注销时应使服务端会话失效。"
    },
    {
      "id": "rate_limit",
      "text": "接口限流应按用户、IP 或令牌设置速率和突发额度，对超限请求返回明确状态，并避免影响正常共享出口用户。"
    },
    {
      "id": "captcha",
      "text": "验证码可增加自动化攻击成本，但不能单独承担鉴权或限流；高风险操作仍需服务端风控。"
    },
    {
      "id": "audit_log",
      "text": "安全审计日志应记录操作者、时间、资源、动作和结果，保护日志完整性，并避免写入明文密钥或敏感数据。"
    },
    {
      "id": "alert_monitoring",
      "text": "安全监控把事件指标与阈值或规则关联，形成告警；应处理误报、告警聚合和通知升级。"
    },
    {
      "id": "secret_scanning",
      "text": "密钥扫描可在代码提交和构建阶段发现泄露凭据；发现后应立即轮换密钥，而不是只删除仓库里的字符串。"
    },
    {
      "id": "data_encryption",
      "text": "静态数据加密与传输加密保护数据机密性，密钥管理、访问控制和轮换同样重要。"
    },
    {
      "id": "container_privilege",
      "text": "容器内执行不可信工具时应使用非 root 用户、禁止提权、限制能力集，并设置只读文件系统和资源上限。"
    },
    {
      "id": "container_network",
      "text": "容器网络隔离应按工具需要配置网络：离线分析可断网，扫描工具只允许访问授权目标，不应默认开放全部出站流量。"
    },
    {
      "id": "prompt_injection",
      "text": "RAG 提示注入来自检索文档中的恶意指令；应用应把检索文本当作不可信数据，限制其对系统指令和工具调用的影响。"
    },
    {
      "id": "rag_poisoning",
      "text": "知识库投毒是攻击者修改或加入错误资料以影响检索结果；应核验资料来源、版本和入库权限。"
    },
    {
      "id": "tool_arguments",
      "text": "Agent 调用工具前应校验参数结构、目标范围和权限，不能让模型生成的命令绕过白名单或执行边界。"
    },
    {
      "id": "browser_evidence",
      "text": "浏览器验证 XSS 时应保留与载荷匹配的实际页面事件证据；模型生成的漏洞描述不能代替真实执行观察。"
    },
    {
      "id": "ioc_indicator",
      "text": "IOC 是 IP、域名、文件哈希等可观测入侵指标；关联情报时要核对来源、时间和误报风险。"
    },
    {
      "id": "attack_tactics",
      "text": "MITRE ATT&CK 描述攻击者战术与技术，可用于映射检测覆盖和事件分析，但单个 IOC 不等同于完整攻击链。"
    },
    {
      "id": "patch_management",
      "text": "漏洞修复应评估资产影响、测试补丁、安排发布窗口并验证回滚方案，最后复测确认问题消失。"
    },
    {
      "id": "vulnerability_scan",
      "text": "漏洞扫描用于发现疑似风险并生成待核查线索；扫描结果需要人工或自动化证据验证，不能直接视为已证实漏洞。"
    }
  ],
  "queries": [
