# Sec-LLM backend configuration example.
# Copy to backend/.env and fill in real values. Never commit .env.

# ---- Runtime ----
ENV_MODE=dev                      # dev | prod (prod enforces JWT check and scan allowlist)
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-chars

# ---- CORS / login throttling ----
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=300
USER_PASSWORD_MIN_LENGTH=10
LOG_USER_QUERIES=false            # true 时把用户提问写进日志（排障用，注意隐私）

# ---- LLM ----
LLM_PROVIDER=local                # local | cloud
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_NAME=llama3:8b
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-chat

# ---- RAG ----
RAG_ONLY_MAX_DISTANCE=1.2
HYBRID_RECALL_ENABLED=true
# 本地模型目录（backend/models/ 默认不入库，需要按 docs 自行下载）
RERANKER_MODEL_PATH=
PROMPT_INTENT_SEMANTIC_ENABLED=true
PROMPT_INTENT_MODEL_PATH=

# ---- Database ----
DATABASE_TYPE=mysql
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=sec_llm_db

# ---- Mail (registration verification) ----
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=
MAIL_PORT=587
DOMAIN_URL=http://localhost:3000

# ---- Agent ----
AGENT_SANDBOX_IMAGE=sec-llm-sandbox:latest
AGENT_MAX_STEPS=20
AGENT_STEP_TIMEOUT_SECONDS=300
AGENT_TASK_TIMEOUT_SECONDS=1800
AGENT_MAX_CONCURRENT=4
AGENT_BROWSER_HEADLESS=true
AGENT_ALLOWED_TARGETS=example.com,192.0.2.10   # 生产必填：精确匹配主机名/IP（入口与工具层双重校验）
AGENT_ALLOW_PRIVATE_TARGETS=false               # true 只用于扫描自建内网/靶场
AGENT_RECON_PORTSCAN=true                       # 无 Docker 时自动跳过
AGENT_CODE_AUDIT_ROOT=                          # 代码审计允许读取的服务端根目录（留空则禁用）
AGENT_CODE_AUDIT_MAX_BYTES=2097152
AGENT_AUTOFIX_ENABLED=false                     # Auto-Fix PR 仅供运维显式调用，不暴露给 Agent

# ---- 扫描纪律与证据 ----
AGENT_MIN_REQUEST_INTERVAL_SECONDS=1.0   # 同源请求最小间隔（限速）
AGENT_CRAWL_MAX_PAGES=20                 # 爬虫页数上限
AGENT_CRAWL_MAX_DEPTH=2                  # 爬虫深度上限
AGENT_SESSION_DIR=data/sessions          # 登录态 storage_state（含会话 Cookie，勿入库）
AGENT_SESSION_TTL_SECONDS=1800
AGENT_EVIDENCE_DIR=artifacts/evidence    # 请求/响应与 PoC 落盘目录

# ---- Uploads ----
MAX_UPLOAD_BYTES=20971520
UPLOAD_ALLOWED_EXTENSIONS=pdf,txt,log,json,csv,md

# ---- Threat intel (optional) ----
ABUSEIPDB_API_KEY=
OTX_API_KEY=
THREAT_INTEL_TIMEOUT_SECONDS=4

# ---- OpenClaw skill (optional; maps to the admin account) ----
SEC_LLM_SKILL_API_KEY=
